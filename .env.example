# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DISCORD_BOT_TOKEN: Token của Discord Bot lấy từ Discord Developer Portal -> Bot -> Reset Token.
# Cấu hình trong mục Secrets của AI Studio để bot tự động online trực tiếp trên máy chủ này.
DISCORD_BOT_TOKEN="MY_DISCORD_BOT_TOKEN"

# DISCORD_CLIENT_ID: Application ID (Client ID) lấy từ Discord Developer Portal -> General Information.
DISCORD_CLIENT_ID="MY_DISCORD_CLIENT_ID"

# DEFAULT_MEMBER_ROLE_ID: Role ID mặc định tự động gán cho thành viên mới khi vào server (Tùy chọn).
DEFAULT_MEMBER_ROLE_ID=""

# ADMIN DASHBOARD AUTHENTICATION
# Dùng để đăng nhập trang điều khiển bot. Không commit file .env thật lên GitHub.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_STRONG_PASSWORD"
# Secret dùng để ký cookie phiên đăng nhập (ít nhất 32 ký tự).
SESSION_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN"


# SOCIAL NOTIFICATION MONITOR
# Tự động kiểm tra YouTube/TikTok và bắn thông báo Discord.
SOCIAL_MONITOR_ENABLED="true"
# Khoảng thời gian kiểm tra, đơn vị milliseconds. 60000 = 1 phút.
SOCIAL_MONITOR_INTERVAL_MS="60000"
# YouTube Data API v3 key (tùy chọn, dùng để phát hiện livestream YouTube chính xác hơn).
YOUTUBE_API_KEY=""
# Nếu không dùng YouTube API, hệ thống sẽ dùng public channel/live page làm fallback.
# TikTok được kiểm tra qua public profile/live page; không cần token cho chế độ cơ bản.
SOCIAL_FALLBACK_CHANNEL_ID=""

# Optional YouTube browser cookies, base64-encoded Netscape cookies.txt. Store only in Render Secrets.
# Needed when YouTube blocks Render/datacenter IPs with "Sign in to confirm you're not a bot".
YOUTUBE_COOKIES_BASE64=""
